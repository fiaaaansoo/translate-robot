#!/usr/bin/env node
import { createCli } from '../dist/cli/index.js';

const program = createCli();

try {
  await program.parseAsync(process.argv);
} catch (error) {
  // commander's exitOverride() makes it throw instead of calling
  // process.exit() itself, so it can be invoked in-process by tests -
  // this is the one place that turns that throw back into a real exit.
  if (error && typeof error === 'object' && 'exitCode' in error) {
    process.exitCode = error.exitCode;
  } else {
    console.error(error instanceof Error ? error.message : String(error));
    process.exitCode = 1;
  }
}
