{
  "name": "translate-robot",
  "version": "0.1.0",
  "description": "Translate new i18n strings so they fit the real rendered width of their UI component (measured in Chromium via Playwright). LLM retry loop, opens a pull request for human review. CLI and GitHub Action.",
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "internationalization",
    "translation",
    "llm",
    "text-overflow",
    "text-expansion",
    "playwright",
    "github-action",
    "cli",
    "pull-request",
    "anthropic",
    "ollama",
    "ui-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiaaaansoo/translate-robot.git"
  },
  "homepage": "https://github.com/fiaaaansoo/translate-robot#readme",
  "bugs": {
    "url": "https://github.com/fiaaaansoo/translate-robot/issues"
  },
  "author": "fiaaaansoo (https://github.com/fiaaaansoo)",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "translate-robot": "./bin/translate-robot"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "format": "prettier --write ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "playwright": "~1.56.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.5"
  }
}
