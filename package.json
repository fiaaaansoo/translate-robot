{
  "name": "translate-robot",
  "version": "0.1.0",
  "description": "Agent pipeline that translates new UI strings under the real visual width constraint of the component they render in, and opens a PR for human review.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "translate-robot": "./bin/translate-robot"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "playwright": "~1.56.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.5"
  }
}
